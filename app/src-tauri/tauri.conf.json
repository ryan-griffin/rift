{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Rift",
	"version": "0.1.0",
	"identifier": "com.rift.app",
	"build": {
		"beforeDevCommand": "bun run dev",
		"beforeBuildCommand": "bun run build",
		"devUrl": "http://localhost:8081",
		"frontendDist": "../.output-tauri/public"
	},
	"app": {
		"windows": [
			{
				"title": "Rift",
				"width": 1100,
				"height": 700,
				"decorations": false
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": ["deb", "rpm", "msi"],
		"icon": [
			"icons/16x16.png",
			"icons/32x32.png",
			"icons/48x48.png",
			"icons/64x64.png",
			"icons/128x128.png",
			"icons/256x256.png",
			"icons/icon.ico",
			"icons/icon.png"
		]
	}
}
